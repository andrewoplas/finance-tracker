# Copy to .env.local and fill in the public Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: server-side AI transaction parsing. Quick-log does not require it.
OPENAI_API_KEY=

# Local MCP adapter: enable only when separately configured and authorized.
FINANCE_MCP_LOCAL_ENABLED=false
FINANCE_MCP_LOCAL_ORIGIN=http://127.0.0.1:4317

# Temporary header-free Dot HTTP testing. Server-side scoped key, never public.
FINANCE_DOT_TEST_MODE=false
FINANCE_DOT_TEST_KEY=

# Dots monthly reflections: dedicated bearer key, fixed owner, server-only DB access.
# Generate key: ft_reflection_ followed by 64 random hexadecimal characters.
FINANCE_DOT_REFLECTION_KEY=
FINANCE_DOT_REFLECTION_OWNER_ID=
SUPABASE_SERVICE_ROLE_KEY=
