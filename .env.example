# Copy to .env.local and fill in the public Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: server-side AI transaction parsing. Quick-log does not require it.
OPENAI_API_KEY=

# Raw credit-card notifications: POST /api/v1/card-notifications.
# Private caller bearer key (32+ random characters); Finance writes use the
# existing FINANCE_DOT_SERVER_KEY, not the OpenAI key.
FINANCE_SMS_HTTP_KEY=
FINANCE_SMS_MODEL=gpt-6-luna
FINANCE_SMS_CARD_MAPPINGS={"2004":{"account":"RCBC Flex Visa","category":"Spending"}}

# Local MCP adapter: enable only when separately configured and authorized.
FINANCE_MCP_LOCAL_ENABLED=false
FINANCE_MCP_LOCAL_ORIGIN=http://127.0.0.1:4317

# Public Dot preview/commit use this private scoped credential to select the owner.
# Callers do not send a bearer token. Must be an active ft_quick_ key.
FINANCE_DOT_SERVER_KEY=
# Legacy server-key fallback; FINANCE_DOT_TEST_MODE is no longer used.
FINANCE_DOT_TEST_KEY=

# Dots monthly reflections: dedicated bearer key, fixed owner, server-only DB access.
# Generate key: ft_reflection_ followed by 64 random hexadecimal characters.
FINANCE_DOT_REFLECTION_KEY=
FINANCE_DOT_REFLECTION_OWNER_ID=
SUPABASE_SERVICE_ROLE_KEY=
